# Base local con docker compose (puerto 5433)
DATABASE_URL="postgresql://manage_fees:manage_fees@localhost:5433/manage_fees?schema=public"
PORT=3000
# Solo si la API corre detrás de un proxy (por ejemplo 1 para un nginx)
# TRUST_PROXY=1
# Contraseña del primer superadmin (opcional; si falta se genera una temporal)
# SUPERADMIN_PASSWORD=
# Horario de la generación automática de cuotas (cron, hora de Argentina). «off» la desactiva.
# CUOTAS_CRON=15 3 * * *
# Nombre de la cooperativa que sale impreso en los recibos
# CLUB_NOMBRE=Cooperativa El Pinar

# Correo saliente para los avisos de vencimiento.
# SMTP_HOST=json deja los correos en el log sin enviarlos: sirve para desarrollo.
# Sin SMTP_HOST los avisos no se pueden activar.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tesoreria@cooperativa.org
# SMTP_PASS=
# SMTP_FROM=tesoreria@cooperativa.org
# «off» desactiva la revisión horaria del proceso de avisos
# AVISOS_CRON=off
